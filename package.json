{
  "name": "gerofarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js && esbuild script/migrate.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/migrate.js",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "tsx --test shared/*.test.ts server/*.test.ts client/src/*.test.ts client/src/app/*.test.ts client/src/app/farm/*.test.ts client/src/app/crops/*.test.ts client/src/app/resources/*.test.ts client/src/app/operations/*.test.ts client/src/app/privacy/*.test.ts",
    "db:check": "tsx script/check-migrations.ts",
    "db:migrate": "tsx script/migrate.ts",
    "db:migrate:prod": "node dist/migrate.js",
    "db:bootstrap-production": "tsx script/bootstrap-production-database.ts",
    "i18n:generate-home": "tsx script/generate-home-locales.ts",
    "i18n:review-home": "tsx script/review-home-locales.ts",
    "i18n:review-app": "tsx script/review-app-locales.ts",
    "catalog:import-legacy-cultures": "tsx script/import-legacy-culture-names.ts",
    "i18n:generate-crops": "tsx script/generate-crop-locales.ts",
    "i18n:review-crops": "tsx script/review-crop-locales.ts",
    "i18n:generate-lifecycle": "tsx script/generate-lifecycle-locales.ts",
    "i18n:review-lifecycle": "tsx script/review-lifecycle-locales.ts",
    "i18n:generate-resources": "tsx script/generate-resource-locales.ts",
    "i18n:review-resources": "tsx script/review-resource-locales.ts",
    "i18n:generate-operations": "tsx script/generate-operation-locales.ts && tsx script/generate-soil-operation-locales.ts && tsx script/review-soil-operation-terms.ts && tsx script/generate-crop-installation-locales.ts",
    "i18n:review-operations": "tsx script/review-operation-locales.ts"
  },
  "dependencies": {
    "@turf/area": "^7.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "pg": "^8.16.3",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.17.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
