NODE_ENV=development
HOST=127.0.0.1
PORT=5000

# Gero Core owns identity, organizations and application access.
GERO_CORE_API_URL=https://api.gero.pt
GERO_CORE_PUBLIC_URL=https://core.gero.pt
GERO_ACCOUNT_PUBLIC_URL=https://account.gero.pt
GERO_CORE_TIMEOUT_MS=5000
GEROFARM_WEATHER_REFRESH_MS=900000

# Public origin and secret used only to sign the local organization selection.
FARM_PUBLIC_URL=http://localhost:5000
FARM_TENANT_SECRET=replace-with-at-least-32-random-characters

# Product persistence. Runtime and migration credentials must be different.
# Leave these unset until PostgreSQL is provisioned; never commit real values.
# DATABASE_URL=postgresql://gero_farm_app:password@localhost:5432/gero_farm
# DATABASE_MIGRATION_URL=postgresql://gero_farm_migrator:password@localhost:5432/gero_farm
# DATABASE_CA_CERT=
